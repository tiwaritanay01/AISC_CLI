%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#ffffff', 'tertiaryColor': '#ffffff'}}}%%
classDiagram
    direction TB

    class LibraryUser {
        <<abstract>>
        #String memberId
        #String name
        #int maxBorrowLimit
        +searchCatalog(String query) List~Book~
    }

    class StudentMember {
        -String dept
        -float outstandingFine
        +requestBorrow(Book b) bool
    }

    class FacultyMember {
        -String designation
        -int extendedDays
        +requestBookPurchase(String isbn) void
    }

    class Librarian {
        -String staffId
        -String shift
        +issueBook(String memberId, String isbn) Loan
        +returnBook(String loanId) void
    }

    class Book {
        -String isbn
        -String title
        -String author
        -String publisher
        -int totalCopies
        -int availableCopies
        +checkAvailability() bool
        +updateStock(int qty) void
    }

    class LoanRecord {
        -String loanId
        -Date issueDate
        -Date dueDate
        -Date returnDate
        -float fineAmount
        +calculateOverdueDays() int
    }

    class Reservation {
        -String resId
        -Date reservedOn
        -String status
        +notifyAvailability() void
    }

    LibraryUser <|-- StudentMember
    LibraryUser <|-- FacultyMember
    LibraryUser "1" --> "*" LoanRecord : holds
    Book "1" --> "*" LoanRecord : borrowed in
    LibraryUser "1" --> "*" Reservation : places
    Book "1" --> "*" Reservation : subject of