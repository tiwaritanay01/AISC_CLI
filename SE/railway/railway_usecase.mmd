%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#ffffff', 'tertiaryColor': '#ffffff'}}}%%
flowchart LR
    classDef default fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000;
    classDef actorStyle fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000,stroke-dasharray: 0;

    subgraph SYSTEM ["Railway Management System (System Boundary)"]
        UC01(["UC01: Register & Authenticate Passenger"])
        UC02(["UC02: Search & View Railway Items"])
        UC03(["UC03: Create New Booking / Request"])
        UC04(["UC04: Process Verification & Approvals"])
        UC05(["UC05: Generate Invoice & Process Payment"])
        UC06(["UC06: Update Central Records & Inventory"])
        UC07(["UC07: Generate Operational & Audit Reports"])
    end

    %% Actors
    Passenger["<<Actor>>\nPassenger"]:::actorStyle
    TicketingClerk["<<Actor>>\nTicketingClerk"]:::actorStyle
    StationMaster["<<Actor>>\nStationMaster"]:::actorStyle
    RailwayAdmin["<<Actor>>\nRailwayAdmin"]:::actorStyle

    %% Actor to Use Case Associations
    Passenger --> UC01
    Passenger --> UC02
    Passenger --> UC03
    Passenger --> UC05
    TicketingClerk --> UC02
    TicketingClerk --> UC03
    TicketingClerk --> UC04
    TicketingClerk --> UC06
    RailwayAdmin --> UC04
    RailwayAdmin --> UC06
    RailwayAdmin --> UC07

    %% Include & Extend Relationships
    UC03 -.->|<<include>>| UC02
    UC04 -.->|<<include>>| UC03
    UC05 -.->|<<include>>| UC04
    UC07 -.->|<<extend>>| UC06