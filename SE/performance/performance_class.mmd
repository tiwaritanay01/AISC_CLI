%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#ffffff', 'tertiaryColor': '#ffffff'}}}%%
classDiagram
    direction TB

    class Employee {
        -String empId
        -String name
        -String department
        -String designation
        +submitGoals() void
        +viewAppraisal() Report
    }

    class Manager {
        -List~String~ reportees
        +evaluateKPI(String empId) Score
        +approvePromotion() void
    }

    class HRAdmin {
        -String policyAccessLevel
        +finalizeAppraisalCycle() void
        +issueIncrementLetter() Letter
    }

    class Goal {
        -String goalId
        -String description
        -Date targetDate
        -float weightage
        -String status
        +updateProgress(float percent) void
    }

    class AppraisalReview {
        -String reviewId
        -float selfRating
        -float managerRating
        -float peerScore
        -String comments
        +computeCompositeScore() float
    }

    class Reward {
        -String rewardId
        -String type
        -float bonusAmount
        -Date grantedOn
        +disburseReward() void
    }

    Employee <|-- Manager
    Employee <|-- HRAdmin
    Employee "1" --> "*" Goal : sets
    Employee "1" --> "*" AppraisalReview : evaluated by
    Manager "1" --> "*" AppraisalReview : conducts
    AppraisalReview "1" --> "0..1" Reward : triggers