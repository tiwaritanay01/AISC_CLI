%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#ffffff', 'tertiaryColor': '#ffffff'}}}%%
classDiagram
    direction TB

    class Person {
        <<abstract>>
        #int id
        #String name
        #String email
        #String phone
        +login() bool
        +logout() void
    }

    class Student {
        -String rollNo
        -String classSection
        -Date dob
        -float feeBalance
        +viewMarks() GradeCard
        +payFee(float amt) Receipt
    }

    class Teacher {
        -String empId
        -String department
        -List~String~ subjects
        +markAttendance(Class c) void
        +enterGrades(Exam e) void
    }

    class SchoolAdmin {
        -String adminId
        -String role
        +createTimetable() Timetable
        +manageTransport() void
    }

    class Course {
        -String courseCode
        -String title
        -int credits
        +getSyllabus() String
    }

    class AttendanceRecord {
        -Date date
        -String status
        -String remarks
        +calculatePercentage() float
    }

    class FeePayment {
        -String receiptId
        -float amount
        -Date paidOn
        -String mode
        +generateReceipt() Receipt
    }

    class TransportRoute {
        -String busNo
        -String driverName
        -List~String~ stops
        +trackGPS() Coordinates
    }

    Person <|-- Student
    Person <|-- Teacher
    Person <|-- SchoolAdmin
    Student "*" --> "1" Course : enrolled in
    Teacher "1" --> "*" Course : instructs
    Student "1" --> "*" AttendanceRecord : has
    Student "1" --> "*" FeePayment : makes
    Student "*" --> "1" TransportRoute : assigned to