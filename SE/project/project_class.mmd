%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#ffffff', 'tertiaryColor': '#ffffff'}}}%%
classDiagram
    direction TB

    class Project {
        -String projId
        -String title
        -Date startDate
        -Date endDate
        -float budget
        -String status
        +calculateProgress() float
        +checkBudgetVariance() float
    }

    class Task {
        -String taskId
        -String title
        -int estHours
        -int actualHours
        -String priority
        -String state
        +assignTo(String devId) void
        +markComplete() void
    }

    class Resource {
        -String resId
        -String name
        -String role
        -float hourlyRate
        +checkAvailability() bool
    }

    class Timesheet {
        -String entryId
        -Date workDate
        -float hoursLogged
        -String comments
        +approve() void
    }

    class Milestone {
        -String milestoneId
        -Date targetDate
        -boolean isDelivered
        +verifyDeliverable() bool
    }

    Project "1" --> "*" Task : consists of
    Task "*" --> "1" Resource : assigned to
    Resource "1" --> "*" Timesheet : submits
    Project "1" --> "*" Milestone : tracks